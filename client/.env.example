# Kisan AI frontend environment variables (placeholders only).
# Copy to .env.local in the client folder (never commit .env.local).

# Base URL of the backend API (Vercel: set VITE_API_URL in Project Settings →
# Environment Variables; it must match the CLIENT_URL allowed by CORS).
VITE_API_URL=http://localhost:5000/api

# Optional legacy alias still supported by src/services/api.js
# VITE_API_BASE_URL=http://localhost:5000/api
