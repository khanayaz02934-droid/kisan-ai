# ============================================================
# Kisan AI - Backend environment variables (placeholders only)
# Copy this file to .env and fill in real values.
# ============================================================

# --- Required ---
# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/kisan-ai

# Secret used to sign JWTs. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_random_hex_string
JWT_EXPIRES_IN=7d

# --- Server ---
PORT=5000
NODE_ENV=development
# Frontend origin allowed by CORS (Vite dev server)
CLIENT_URL=http://localhost:5173

# Auth rate limiting: attempts allowed per 15 minutes per IP (default 10)
AUTH_RATE_LIMIT_MAX=10

# --- AI Crop Scanner (required for /api/scans analysis) ---
# Get a free Gemini API key at https://aistudio.google.com/
GEMINI_API_KEY=
# Primary model. Must support image input. Verified working (Oct 2026):
# gemini-3.5-flash, gemini-3.1-flash-lite, gemini-3.5-flash-lite.
# gemini-2.5-flash returns 404 "no longer available to new users" on new keys.
GEMINI_MODEL=gemini-3.8-flash
# Fallback model(s), comma separated, must work with the SAME API key.
# Switched to ONLY for retryable errors (503/429); never for auth/invalid/quota.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash,gemini-3.1-flash-lite
# Retry budget for temporary errors (default: 2 retries, 1s base backoff,
# 10s max single wait incl. Retry-After, 30s per-attempt request timeout).
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_MS=1000
GEMINI_RETRY_MAX_DELAY_MS=10000
GEMINI_TIMEOUT_MS=30000

# --- Mandi prices (data.gov.in Agmarknet "Current Daily Price" dataset) ---
# Register for a free key at https://data.gov.in/user/register
DATA_GOV_API_KEY=
# Aamkrnet current-daily-price resource id (default works out of the box)
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# --- Image storage for scan uploads (Cloudinary) ---
# EITHER set a connection string:
CLOUDINARY_URL=
# OR all three of:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
